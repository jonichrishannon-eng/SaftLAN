---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Admin - SaftLAN Sync">
  <main class="min-h-screen bg-neutral-950 text-neutral-100 p-8 font-sans">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-4xl font-black tracking-tighter mb-8 text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-violet-500">
        SYSTEM_SYNC
      </h1>

      <div class="bg-neutral-900 border border-neutral-800 p-6 rounded-2xl shadow-2xl relative overflow-hidden">
        <!-- Decor element -->
        <div class="absolute -top-10 -right-10 w-32 h-32 bg-pink-500/10 blur-3xl rounded-full"></div>

        <p class="text-neutral-400 mb-6 text-sm">
          Enter your GitHub Personal Access Token to sync products from the showcase repository and automatically fetch missing images from OpenFoodFacts.
        </p>

        <form
          data-on-submit="@post('/api/sync')"
          class="space-y-4 relative z-10"
        >
          <div>
            <label for="token" class="block text-xs font-bold uppercase tracking-widest text-neutral-500 mb-2">GitHub PAT</label>
            <input
              type="password"
              id="token"
              name="token"
              required
              class="w-full bg-neutral-950 border border-neutral-800 rounded-lg px-4 py-3 text-neutral-100 focus:outline-none focus:border-pink-500 transition-colors"
              placeholder="ghp_xxxxxxxxxxxxxxxxxxxx"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-gradient-to-r from-pink-500 to-violet-500 hover:from-pink-400 hover:to-violet-400 text-white font-bold py-3 px-4 rounded-lg shadow-lg shadow-pink-500/20 transition-all active:scale-95"
          >
            INITIATE SYNC SEQUENCE
          </button>
        </form>

        <div id="sync-result" class="mt-6"></div>
      </div>

      <div class="mt-8 bg-neutral-900 border border-neutral-800 p-6 rounded-2xl shadow-2xl">
         <h2 class="text-xl font-bold mb-4">Manual Image Overrides</h2>
         <p class="text-sm text-neutral-400 mb-4">To manually override an image for a product, edit the <code class="bg-neutral-950 px-1 rounded">src/data/overrides.json</code> file in the repository.</p>
         <pre class="bg-neutral-950 p-4 rounded-lg text-xs text-pink-300 overflow-x-auto">
{`{
  "600380": "https://example.com/custom-image.jpg"
}`}
         </pre>
      </div>

      <div class="mt-8 text-center">
        <a href="/" class="text-neutral-500 hover:text-pink-400 transition-colors text-sm uppercase tracking-widest font-bold">← Back to Kiosk</a>
      </div>
    </div>
  </main>

  <!-- Load Datastar -->
  <script is:inline src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v0.19.9/bundles/datastar.js" type="module"></script>
</Layout>