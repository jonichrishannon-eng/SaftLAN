---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Admin - SaftLAN Sync">
  <main class="min-h-screen bg-neutral-950 text-neutral-100 p-8 font-sans">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-4xl font-black tracking-tighter mb-8 text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-violet-500">
        SYSTEM_SYNC
      </h1>

      <div class="bg-neutral-900 border border-neutral-800 p-6 rounded-2xl shadow-2xl relative overflow-hidden">
        <!-- Decor element -->
        <div class="absolute -top-10 -right-10 w-32 h-32 bg-pink-500/10 blur-3xl rounded-full"></div>

        <p class="text-neutral-400 mb-6 text-sm">
          Enter your GitHub Personal Access Token to sync products from the showcase repository and automatically fetch missing images from OpenFoodFacts directly from your browser.
        </p>

        <form
          id="sync-form"
          class="space-y-4 relative z-10"
        >
          <div>
            <label for="token" class="block text-xs font-bold uppercase tracking-widest text-neutral-500 mb-2">GitHub PAT (Needs repo access)</label>
            <input
              type="password"
              id="token"
              name="token"
              required
              class="w-full bg-neutral-950 border border-neutral-800 rounded-lg px-4 py-3 text-neutral-100 focus:outline-none focus:border-pink-500 transition-colors"
              placeholder="ghp_xxxxxxxxxxxxxxxxxxxx"
            />
          </div>

          <button
            type="submit"
            id="sync-btn"
            class="w-full bg-gradient-to-r from-pink-500 to-violet-500 hover:from-pink-400 hover:to-violet-400 text-white font-bold py-3 px-4 rounded-lg shadow-lg shadow-pink-500/20 transition-all active:scale-95 disabled:opacity-50"
          >
            INITIATE SYNC SEQUENCE
          </button>
        </form>

        <div id="sync-result" class="mt-6 text-sm whitespace-pre-wrap font-mono overflow-auto max-h-64"></div>
      </div>

      <div class="mt-8 bg-neutral-900 border border-neutral-800 p-6 rounded-2xl shadow-2xl">
         <h2 class="text-xl font-bold mb-4">Manual Image Overrides</h2>
         <p class="text-sm text-neutral-400 mb-4">To manually override an image for a product, edit the <code class="bg-neutral-950 px-1 rounded">src/data/overrides.json</code> file in the repository.</p>
         <pre class="bg-neutral-950 p-4 rounded-lg text-xs text-pink-300 overflow-x-auto">
{`{
  "600380": "https://example.com/custom-image.jpg"
}`}
         </pre>
      </div>

      <div class="mt-8 text-center">
        <a href="/SaftLAN/" class="text-neutral-500 hover:text-pink-400 transition-colors text-sm uppercase tracking-widest font-bold">← Back to Kiosk</a>
      </div>
    </div>
  </main>

  <script is:inline src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"></script>

  <script>
    document.getElementById('sync-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const tokenInput = document.getElementById('token') as HTMLInputElement;
      const token = tokenInput?.value;
      const resultDiv = document.getElementById('sync-result');
      const btn = document.getElementById('sync-btn') as HTMLButtonElement;

      if (!token || !resultDiv || !btn) return;

      const log = (msg: string, isError = false) => {
        const p = document.createElement('div');
        p.textContent = `> ${msg}`;
        p.className = isError ? 'text-red-400' : 'text-cyan-400';
        resultDiv.appendChild(p);
        resultDiv.scrollTop = resultDiv.scrollHeight;
      };

      btn.disabled = true;
      resultDiv.innerHTML = '';
      log('Starting sync protocol...');

      const repoOwner = 'jonichrishannon-eng';
      const repoName = 'SaftLAN';

      const ghHeaders = {
        'Authorization': `token ${token}`,
        'Accept': 'application/vnd.github.v3+json',
        'Content-Type': 'application/json'
      };

      try {
        // Helper function for GH API
        const ghRequest = async (path: string, method = 'GET', body: any = null) => {
          const options: RequestInit = { method, headers: ghHeaders };
          if (body) options.body = JSON.stringify(body);
          const res = await fetch(`https://api.github.com/repos/${repoOwner}/${repoName}${path}`, options);
          if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            throw new Error(`GitHub API error (${res.status}): ${errData.message || res.statusText}`);
          }
          return res.json();
        };

        // 1. Fetch produkte.csv from saftladen-showcase
        log('Fetching produkte.csv from showcase repo...');
        const csvRes = await fetch('https://raw.githubusercontent.com/jonichrishannon-eng/saftladen-showcase/main/produkte.csv');
        if (!csvRes.ok) throw new Error('Failed to fetch produkte.csv');
        const csvText = await csvRes.text();

        // @ts-ignore
        const parsed = Papa.parse(csvText, { header: true, skipEmptyLines: true, delimiter: ';' });
        const products = parsed.data as Array<{ ArtNr: string, Name: string, Preis: string }>;
        log(`Found ${products.length} products.`);

        // 2. Fetch overrides from this repo via GH API
        let overrides: Record<string, string> = {};
        try {
          log('Fetching overrides.json...');
          const overRes = await ghRequest('/contents/src/data/overrides.json');
          if (overRes.content) {
            overrides = JSON.parse(atob(overRes.content));
            log('Loaded overrides.');
          }
        } catch (e) {
          log('No overrides found or error reading overrides.json. Proceeding without overrides.', true);
        }

        // We need the latest commit SHA on main to make updates
        log('Getting latest commit ref on main...');
        let refData = await ghRequest('/git/refs/heads/main');
        let latestCommitSha = refData.object.sha;

        let commitData = await ghRequest(`/git/commits/${latestCommitSha}`);
        let baseTreeSha = commitData.tree.sha;

        const finalProducts = [];
        const newTreeItems = []; // Collect files to update in one commit

        for (const prod of products) {
          let imageUrl = overrides[prod.ArtNr] || null;
          const localImageName = `${prod.ArtNr}.jpg`;

          if (!imageUrl) {
            // Check if image exists in repo already
            let imageExists = false;
            try {
              await ghRequest(`/contents/public/images/${localImageName}`);
              imageExists = true;
              log(`Image ${localImageName} already exists in repo.`);
            } catch {
              imageExists = false;
            }

            if (!imageExists) {
              log(`Searching OpenFoodFacts for: ${prod.Name}`);
              const offRes = await fetch(`https://world.openfoodfacts.org/cgi/search.pl?search_terms=${encodeURIComponent(prod.Name)}&search_simple=1&action=process&json=1&page_size=1`);
              if (offRes.ok) {
                const offData = await offRes.json();
                if (offData.products && offData.products.length > 0) {
                  const bestMatch = offData.products[0];
                  const foundImageUrl = bestMatch.image_url || bestMatch.image_front_url;

                  if (foundImageUrl) {
                    log(`Found image: ${foundImageUrl}`);
                    try {
                      // Fetch image as blob
                      const imgRes = await fetch(foundImageUrl);
                      const blob = await imgRes.blob();

                      // Convert to base64
                      const base64data = await new Promise<string>((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onloadend = () => {
                           const res = reader.result as string;
                           // result is data:image/jpeg;base64,..... we just need the base64 part
                           resolve(res.split(',')[1]);
                        };
                        reader.onerror = reject;
                        reader.readAsDataURL(blob);
                      });

                      // Create blob in GitHub
                      log(`Creating blob for ${localImageName}...`);
                      const blobData = await ghRequest('/git/blobs', 'POST', {
                        content: base64data,
                        encoding: 'base64'
                      });

                      newTreeItems.push({
                        path: `public/images/${localImageName}`,
                        mode: '100644',
                        type: 'blob',
                        sha: blobData.sha
                      });
                    } catch (e: any) {
                      log(`Error downloading/blobbing image for ${prod.Name}: ${e.message}`, true);
                    }
                  } else {
                     log(`No image URL returned from OpenFoodFacts for ${prod.Name}`);
                  }
                } else {
                   log(`No matches on OpenFoodFacts for ${prod.Name}`);
                }
              }
            }
          }

          if (!imageUrl) {
            // Because Astro is configured with base: '/SaftLAN', the image path must be relative to the domain root
            // Astro handles paths in the public folder. It's safer to use a relative or absolute path taking base into account if deployed.
            // When using static deployment, paths from public/ are just at the root. But with a base path, we need to prefix.
            imageUrl = `/SaftLAN/images/${localImageName}`;
          }

          finalProducts.push({
            ...prod,
            image: imageUrl
          });
        }

        // Create blob for products.json
        log('Creating blob for products.json...');
        const productsJsonContent = JSON.stringify(finalProducts, null, 2);
        const productsBlobData = await ghRequest('/git/blobs', 'POST', {
          content: productsJsonContent,
          encoding: 'utf-8'
        });

        newTreeItems.push({
          path: 'src/data/products.json',
          mode: '100644',
          type: 'blob',
          sha: productsBlobData.sha
        });

        if (newTreeItems.length > 0) {
          log(`Creating new tree with ${newTreeItems.length} changes...`);
          const treeData = await ghRequest('/git/trees', 'POST', {
            base_tree: baseTreeSha,
            tree: newTreeItems
          });

          log('Creating commit...');
          const newCommitData = await ghRequest('/git/commits', 'POST', {
            message: 'Auto-sync: Update products.json and download missing images',
            tree: treeData.sha,
            parents: [latestCommitSha]
          });

          log('Updating ref (pushing to main)...');
          await ghRequest('/git/refs/heads/main', 'PATCH', {
            sha: newCommitData.sha
          });

          log('SYNC COMPLETE! GitHub Pages should rebuild shortly with the new data.', false);
          log('Note: You may need to wait 1-2 minutes and refresh the kiosk page.');
        } else {
           log('No changes needed. Sync complete.');
        }

      } catch (err: any) {
        log(`SYNC FAILED: ${err.message}`, true);
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</Layout>