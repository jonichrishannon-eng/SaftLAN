---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs/promises';
import path from 'node:path';

let products: Array<{ ArtNr: string, Name: string, Preis: string, image?: string }> = [];
try {
  const productsStr = await fs.readFile(path.join(process.cwd(), 'src/data/products.json'), 'utf-8');
  products = JSON.parse(productsStr);
} catch (e) {
  console.warn("No products found yet.");
}
---

<Layout title="SaftLAN - Kiosk">
  <main class="min-h-screen relative overflow-hidden font-sans pb-32" data-store="{ cartTotal: 0 }">
    <!-- Crazy Background Elements -->
    <div class="fixed top-[-10%] left-[-10%] w-[50vw] h-[50vw] bg-pink-600/20 rounded-full blur-[120px] mix-blend-screen pointer-events-none"></div>
    <div class="fixed bottom-[-20%] right-[-10%] w-[60vw] h-[60vw] bg-cyan-600/20 rounded-full blur-[150px] mix-blend-screen pointer-events-none"></div>
    <div class="fixed top-[40%] left-[30%] w-[30vw] h-[30vw] bg-yellow-500/10 rounded-full blur-[100px] mix-blend-screen pointer-events-none"></div>

    <div class="container mx-auto px-4 py-12 relative z-10">

      <!-- Header -->
      <header class="mb-20 text-center gsap-header">
        <h1 class="text-7xl md:text-9xl font-black uppercase tracking-tighter glitch-effect mb-4" data-text="SaftLAN">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-500 via-purple-500 to-cyan-500">SaftLAN</span>
        </h1>
        <p class="text-2xl md:text-3xl font-bold text-yellow-400 uppercase tracking-widest rotate-[-2deg] inline-block bg-black px-4 py-2 border-2 border-yellow-400">
          The Ultimate Kiosk Experience
        </p>
      </header>

      <!-- Cart Tracker (Datastar target) -->
      <div class="fixed bottom-8 right-8 z-50 gsap-cart">
        <div id="cart-container" class="bg-gradient-to-br from-neutral-900 to-black border-2 border-pink-500 p-4 rounded-2xl shadow-[0_0_30px_rgba(255,0,127,0.5)] transform rotate-3">
          <div class="text-xl font-black text-white flex items-center gap-3">
            <span class="text-3xl">🛒</span>
            <div>
              <div class="text-sm text-pink-400 uppercase tracking-widest">Total</div>
              <div class="text-2xl" data-text="`${$cartTotal.toFixed(2)} €`">0.00 €</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Products Grid -->
      {products.length === 0 ? (
        <div class="text-center bg-neutral-900/50 p-12 rounded-3xl border border-neutral-800 backdrop-blur-sm max-w-2xl mx-auto gsap-empty">
          <h2 class="text-4xl font-bold mb-4 text-cyan-400">NO PRODUCTS DETECTED</h2>
          <p class="text-neutral-400 mb-8 text-lg">System empty. Please initiate sync protocol.</p>
          <a href="/admin" class="inline-block bg-pink-600 hover:bg-pink-500 text-white font-black py-4 px-8 rounded-full uppercase tracking-widest transition-transform hover:scale-110 shadow-[0_0_20px_rgba(255,0,127,0.4)]">
            Go to Admin Sync
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
          {products.map((p: { ArtNr: string, Name: string, Preis: string, image?: string }, index: number) => (
            <div
              class={`product-card bg-neutral-900/80 backdrop-blur-md rounded-3xl overflow-hidden border-2 border-neutral-800 hover:border-cyan-400 flex flex-col relative group gsap-item`}
              style={`--item-index: ${index};`}
            >
              <!-- Decorative corner -->
              <div class="absolute -top-4 -right-4 w-12 h-12 bg-pink-500 rotate-45 z-0 group-hover:bg-yellow-400 transition-colors"></div>

              <div class="h-64 bg-black p-6 flex items-center justify-center relative z-10 overflow-hidden">
                {p.image ? (
                  <img src={p.image} alt={p.Name} class="max-h-full object-contain filter group-hover:drop-shadow-[0_0_15px_rgba(0,240,255,0.8)] transition-all duration-300 transform group-hover:scale-110" />
                ) : (
                  <div class="text-neutral-700 text-6xl font-black">?</div>
                )}

                <!-- Price Tag -->
                <div class="absolute bottom-4 left-4 bg-yellow-400 text-black font-black text-xl py-1 px-3 rounded-lg transform -rotate-6 shadow-lg border-2 border-black">
                  {p.Preis} €
                </div>
              </div>

              <div class="p-6 flex-grow flex flex-col justify-between relative z-10">
                <div>
                  <div class="text-xs text-cyan-500 font-mono mb-2 bg-cyan-950/50 inline-block px-2 py-1 rounded">ID: {p.ArtNr}</div>
                  <h3 class="text-xl font-bold leading-tight mb-4 group-hover:text-pink-400 transition-colors line-clamp-3">{p.Name}</h3>
                </div>

                <button
                  class="w-full mt-4 bg-transparent border-2 border-pink-500 text-pink-500 hover:bg-pink-500 hover:text-white font-black py-3 rounded-xl uppercase tracking-wider transition-all active:scale-95"
                  data-on-click={`$cartTotal += parseFloat('${p.Preis.replace(',', '.')}')`}
                >
                  ADD TO CART
                </button>
              </div>
            </div>
          ))}
        </div>
      )}

    </div>
  </main>

  <script is:inline src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v0.19.9/bundles/datastar.js" type="module"></script>

  <script>
    import { gsap } from 'gsap';

    // Initial animations
    document.addEventListener("DOMContentLoaded", () => {
      const tl = gsap.timeline();

      tl.from(".gsap-header", {
        y: -100,
        opacity: 0,
        duration: 1,
        ease: "bounce.out"
      })
      .from(".gsap-empty", {
        scale: 0.8,
        opacity: 0,
        duration: 0.5,
        ease: "back.out(1.7)"
      }, "-=0.5")
      .from(".gsap-item", {
        y: 100,
        opacity: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: "power3.out"
      }, "-=0.5")
      .from(".gsap-cart", {
        x: 100,
        opacity: 0,
        duration: 0.8,
        ease: "elastic.out(1, 0.5)",
        rotation: 45
      }, "-=0.5");

      // Floating animation for cart
      gsap.to("#cart-container", {
        y: -10,
        rotation: 0,
        duration: 2,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut"
      });
    });
  </script>
</Layout>